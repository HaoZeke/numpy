project('fib_wrapper', 'c',
  version : '0.1.0',
  meson_version: '>=1.1.0',
  default_options : ['warning_level=2'],
)

add_languages('fortran', native: false)

py = import('python').find_installation(pure: false)

# NumPy >=2.0 provides include dirs via dependency(), and >=2.6 also reports
# the directory holding fortranobject.{c,h}. The version constraint skips an
# older numpy.pc on the default pkg-config path, e.g. from a system package.
np_dep = dependency('numpy', version : '>=2.6')

# The f2py include dir is not in the compile flags of dependency('numpy'),
# so add it separately. Pass it as a flag like dependency('numpy') does:
# include_directories() rejects absolute paths into the source tree, which
# is where it points when the virtual environment lives in the project.
incdir_f2py = np_dep.get_variable(
  pkgconfig : 'f2py_includedir',
  configtool : 'f2py-includedir',
)
f2py_dep = declare_dependency(
  compile_args : '-I' + incdir_f2py,
)

# Generate the f2py wrappers
fib_source = custom_target('fibmodule.c',
  input : ['fib.f90'],
  output : ['fibmodule.c', 'fib-f2pywrappers.f'],
  command : [py, '-m', 'numpy.f2py', '@INPUT@', '-m', 'fib', '--lower']
)

py.extension_module('fib',
  ['fib.f90', fib_source, incdir_f2py / 'fortranobject.c'],
  dependencies : [np_dep, f2py_dep],
  subdir: 'fib_wrapper',
  install : true,
)

# Install the Python package files
py.install_sources(
  'fib_wrapper/__init__.py',
  subdir: 'fib_wrapper',
)

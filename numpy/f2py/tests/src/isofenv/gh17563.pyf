python module gh17563
    interface
        subroutine func(i, x)
            fortranname pyfunc
            use iso_fortran_env, only: sp=>real32, dp=>real64, qp=>real128
            use iso_fortran_env, only: int8, int16, int32, int64
            integer(int32), intent(in) :: i
            real(dp), intent(out) :: x
        end subroutine func
    end interface
end python module gh17563

project('${modulename}',
        version : '0.1',
        meson_version: '>= 1.1.0',
        default_options : [
                            'warning_level=1',
                            'buildtype=${buildtype}'
                          ])
# Host only: languages passed to project() are also set up for the build machine
add_languages('c', 'fortran', native: false)
fc = meson.get_compiler('fortran')
cc = meson.get_compiler('c')

add_project_arguments(
  cc.get_supported_arguments( '-fno-strict-aliasing'), language : 'c'
)

# The C wrappers reference Fortran symbols as lowercase names with a
# trailing underscore, Intel Fortran on Windows defaults to neither
if fc.get_id() in ['intel-cl', 'intel-llvm-cl']
  add_project_arguments('/names:lowercase', '/assume:underscore',
                        language : 'fortran')
endif

py = import('python').find_installation('''${python}''', pure: false)
py_dep = py.dependency()

incdir_numpy = '''${incdir_numpy}'''
incdir_f2py = '''${incdir_f2py}'''
fortranobject_c = incdir_f2py / 'fortranobject.c'

inc_np = include_directories(incdir_numpy, incdir_f2py)
# gh-30804: build fortranobject.c as its own static library so its
# helpers stay hidden. The extension keeps default visibility, which
# ifx needs in order to bind omp_lib. Link it with link_with.
fortranobject_lib = static_library('_fortranobject',
                     fortranobject_c,
                     include_directories: [inc_np],
                     dependencies: py_dep,
                     gnu_symbol_visibility: 'hidden',
                     )
# gh-25000
quadmath_dep = fc.find_library('quadmath', required: false)

# LLVM flang >= 19 does not put its runtime on a C link of a Python
# extension, so print and character intrinsics stay undefined.
flang_runtime_deps = []
if fc.get_id() == 'llvm-flang'
  _fs = import('fs')
  _res = run_command(fc.cmd_array(), '-print-resource-dir', check: true).stdout().strip()
  _libdir = _fs.parent(_fs.parent(_res))
  _rt = fc.find_library('FortranRuntime', dirs: [_libdir], static: true, required: false)
  _dec = fc.find_library('FortranDecimal', dirs: [_libdir], static: true, required: false)
  _mlib = cc.find_library('m', required: false)
  if _rt.found()
    flang_runtime_deps += _rt
  endif
  if _dec.found()
    flang_runtime_deps += _dec
  endif
  if _mlib.found()
    flang_runtime_deps += _mlib
  endif
endif

${lib_declarations}
${lib_dir_declarations}

py.extension_module('${modulename}',
                     [
${source_list}
                     ],
                     # gh-30804: only the Fortran compiler driver knows its
                     # runtime libraries and their run paths
                     link_language: 'fortran',
                     # gh-30804: ifx also applies -fvisibility=hidden to
                     # references, which then cannot bind to shared libraries
                     gnu_symbol_visibility: 'default',
                     link_with: fortranobject_lib,
                     include_directories: [
                     inc_np,
${inc_list}
                     ],
                     objects: [
${obj_list}
                     ],
                     dependencies : flang_runtime_deps + [
                     py_dep,
                     quadmath_dep,
${dep_list}
${lib_list}
${lib_dir_list}
                     ],
${c_args}
${fortran_args}
                     link_language: 'fortran',
                     # Intel Fortran applies -fvisibility to external references
                     # too, and hidden references cannot bind to shared libraries
                     gnu_symbol_visibility : 'default',
                     install : true)
